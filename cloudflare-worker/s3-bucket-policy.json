{
  "_comment": "SECURITY: CF_S3_SECRET value must NEVER be committed here. Use placeholder only. Apply via: aws s3api put-bucket-policy --bucket cdn.digital-ai.tech --policy file://s3-bucket-policy.json after substituting ${CF_S3_SECRET} with the real value from Wrangler secrets.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPublicRead",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::cdn.digital-ai.tech/*"
    },
    {
      "Sid": "DenyMediaHubWithoutRefererSecret",
      "Effect": "Deny",
      "NotPrincipal": {
        "AWS": [
          "arn:aws:iam::110013536163:user/transcription-service-bot",
          "arn:aws:iam::110013536163:root"
        ]
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::cdn.digital-ai.tech/media-hub/*",
      "Condition": {
        "StringNotEquals": {
          "aws:Referer": "${CF_S3_SECRET}"
        }
      }
    },
    {
      "Sid": "AllowTranscriptionBotWriteMediaHub",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::110013536163:user/transcription-service-bot"
      },
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::cdn.digital-ai.tech/media-hub/*"
    }
  ]
}
